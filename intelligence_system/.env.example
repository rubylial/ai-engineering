# =============================================================================
# The Intelligence System — variables de entorno
# Copiá este archivo como .env y completá las 3 claves marcadas con (OBLIGATORIA).
# .env está en .gitignore: nunca lo subas al repo.
# Todo lo demás tiene un valor por defecto razonable.
# =============================================================================

# --- Claves -------------------------------------------------------------------
# (OBLIGATORIA) Clave de Anthropic para el LLM.
ANTHROPIC_API_KEY=
# (OBLIGATORIA) Clave de Pinecone: vector store + embeddings (Pinecone Inference).
PINECONE_API_KEY=
# (OBLIGATORIA) Clave que inventás vos para proteger la API (header X-API-Key).
API_KEY=cambia-esta-clave-larga-y-secreta

# --- Aplicación ---------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
# true = logs en JSON (recomendado); false = formato legible para desarrollo
LOG_JSON=true

# --- Puertos del host (docker compose) ----------------------------------------
API_PORT=8000
PHOENIX_PORT=6006
REDIS_PORT=6379

# --- LLM (cliente unificado de la pre-entrega 1) -------------------------------
# anthropic | openai | fake (fake = sin red, solo pruebas)
LLM_PROVIDER=anthropic
# Supervisor: decide el ruteo. Workers: grader de evidencia, analyst y writer.
# Modelos activos verificados en la página de deprecaciones de Anthropic (2026-11-05).
# Si el ruteo falla seguido, subí solo el supervisor a claude-sonnet-5-5.
LLM_MODEL_SUPERVISOR=claude-haiku-5-5
LLM_MODEL_WORKER=claude-haiku-5-5
LLM_MAX_TOKENS_SUPERVISOR=400
LLM_MAX_TOKENS_WORKER=800
LLM_MAX_TOKENS_WRITER=1024
# Opcional. El SDK anthropic>=2.5.0 no acepta temperature: solo se usa con OpenAI.
LLM_TEMPERATURE=
LLM_TIMEOUT_S=60
# Reintentos con backoff exponencial + jitter (solo errores transitorios: 429, red, 5xx)
LLM_MAX_RETRIES=3
LLM_RETRY_MIN_WAIT_S=1
LLM_RETRY_MAX_WAIT_S=20
LLM_MAX_CONCURRENCY=8
# Intentos de reparación cuando la salida estructurada no valida con Pydantic
LLM_STRUCTURED_MAX_ATTEMPTS=2
# Solo si LLM_PROVIDER=openai
OPENAI_API_KEY=

# --- Embeddings (Pinecone Inference) -------------------------------------------
# pinecone | fake (fake = embeddings por hashing, solo pruebas)
EMBEDDINGS_PROVIDER=pinecone
EMBEDDINGS_MODEL=multilingual-e5-large
# Debe coincidir con el modelo: multilingual-e5-large = 1024
EMBEDDINGS_DIMENSION=1024
EMBEDDINGS_BATCH_SIZE=64
EMBEDDINGS_MAX_CONCURRENCY=4

# --- Vector store (Pinecone serverless, índice híbrido) -------------------------
# pinecone | memory (memory = sin red, solo pruebas)
VECTOR_STORE=pinecone
# Se crea solo si no existe (denso dotproduct + campo sparse). Usá un nombre nuevo:
# un índice viejo de la pre-entrega 4 (cosine, 384 dims) no es compatible.
PINECONE_INDEX_NAME=intelligence-system
PINECONE_NAMESPACE=ai-engineering-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_UPSERT_BATCH_SIZE=100
PINECONE_TIMEOUT_S=30
PINECONE_CREATE_TIMEOUT_S=180

# --- RAG ------------------------------------------------------------------------
RAG_CORPUS_DIR=data/corpus
# Tamaño en caracteres (~4 caracteres por token en español)
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=150
RAG_MIN_CHUNK_CHARS=40
RAG_TOP_K=5
RAG_FETCH_K=20
# 1.0 = solo semántico, 0.0 = solo BM25, 0.7 = híbrido con más peso semántico
RAG_HYBRID_ALPHA=0.7
# Rerank con cross-encoder hosteado en Pinecone (consume cuota de rerank)
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=bge-reranker-v2-m3
# Grader LLM que descarta fragmentos irrelevantes antes del writer
RAG_GRADE_EVIDENCE=true
RAG_SNIPPET_CHARS=300
BM25_K1=1.2
BM25_B=0.75
BM25_REDIS_PREFIX=bm25

# --- Redis / persistencia ---------------------------------------------------------
# En docker compose se pisa con redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
# redis | memory (memory = las conversaciones se pierden al reiniciar)
CHECKPOINTER_BACKEND=redis
# Vacío = las conversaciones no expiran. Un número = minutos sin actividad.
CHECKPOINT_TTL_MINUTES=

# --- Agentes ------------------------------------------------------------------------
# Pasos de workers por turno antes de forzar al writer
AGENT_MAX_STEPS=4
# Tope duro de supersteps de LangGraph (red de seguridad contra bucles)
AGENT_RECURSION_LIMIT=25
# Timeout de cada nodo (asyncio.timeout) y deadline total del turno
AGENT_NODE_TIMEOUT_S=45
AGENT_REQUEST_TIMEOUT_S=120
# Mensajes previos que ven supervisor y writer (contexto mínimo)
AGENT_HISTORY_WINDOW=8
AGENT_ANALYST_MAX_TOOL_CALLS=4

# --- Observabilidad (Arize Phoenix) --------------------------------------------------
PHOENIX_ENABLED=true
# En docker compose se pisa con http://phoenix:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=intelligence-system
# URL que abrís en el navegador (la usan los links de run_scenarios.py)
PHOENIX_UI_URL=http://localhost:6006
# Exportación en lote desde un hilo aparte: no la desactives en producción
PHOENIX_BATCH_EXPORT=true
# true = agrega spans HTTP nativos de FastAPI (la raíz pasa a ser POST /v1/chat)
PHOENIX_HTTP_SPANS=false
